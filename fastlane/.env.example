# Copy to fastlane/.env (ignored by git) and fill in. Nothing here is committed.
# App Store Connect API key: App Store Connect > Users and Access > Integrations > App Store Connect API.
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# Optional: the team, if you belong to more than one.
APPLE_TEAM_ID=
